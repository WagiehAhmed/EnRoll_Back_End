{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 4000
        }
      ],
      "UpstreamPathTemplate": "/users/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "Key": "UsersRoute",
      "Priority": 1,
      "RateLimitOptions": {
        "ClientIdHeader": "X-Client-Id",
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "EnableHeaders": true,
        "Limit": 100,
        "Period": "1m",
        "PeriodTimespan": 60,
        "StatusCode": 429,
        "QuotaExceededMessage": "Client request quota exceeded for your ClientId or JWT user account."
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
